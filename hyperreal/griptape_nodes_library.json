{
    "name": "HyperReal Nodes",
    "library_schema_version": "0.5.0",
    "settings": [
        {
            "description": "API key required by nodes in this library",
            "category": "app_events.on_app_initialization_complete",
            "contents": {
                "secrets_to_register": [
                    "HEYGEN_API_KEY",
                    "TOPAZ_API_KEY",
                    "WAVESPEED_API_KEY",
                    "DO_SPACES_KEY",
                    "DO_SPACES_SECRET",
                    "DO_SPACES_REGION",
                    "DO_SPACES_ENDPOINT",
                    "RUNCOMFY_TOKEN"
                ]
            }
        }
    ],
    "metadata": {
        "author": "HyperReal",
        "description": "HyperReal's custom Griptape Nodes: HeyGen avatar lipsync video generation and video translation, Topaz video and still-image upscaling, WaveSpeed image editing and InfiniteTalk video, face-swap prep (detect/crop/composite), chroma-key compositing, DigitalOcean Spaces uploads, with ViewComfy nodes to follow.",
        "library_version": "0.10.0",
        "engine_version": "0.86.0",
        "tags": [
            "HyperReal",
            "HeyGen",
            "Video",
            "AI",
            "Lipsync",
            "Translation"
        ],
        "dependencies": {
            "pip_dependencies": [
                "requests",
                "boto3",
                "opencv-python",
                "numpy",
                "static-ffmpeg>=2.8"
            ]
        }
    },
    "categories": [
        {
            "video/heygen": {
                "color": "border-red-500",
                "title": "HeyGen",
                "description": "Video generation and translation nodes using the HeyGen API",
                "icon": "Video"
            }
        },
        {
            "video/topaz": {
                "color": "border-purple-500",
                "title": "Topaz",
                "description": "Video enhancement and upscaling nodes using the Topaz Labs API",
                "icon": "Video"
            }
        },
        {
            "video/wavespeed": {
                "color": "border-emerald-500",
                "title": "WaveSpeed",
                "description": "InfiniteTalk talking-video nodes using the WaveSpeed AI API",
                "icon": "Video"
            }
        },
        {
            "image/topaz": {
                "color": "border-purple-500",
                "title": "Topaz",
                "description": "Still-image upscaling and face recovery using the Topaz Labs Image API",
                "icon": "Image"
            }
        },
        {
            "image/faceprep": {
                "color": "border-amber-500",
                "title": "Face Prep",
                "description": "Image-domain head framing for face-swap and zoomed lipsync passes",
                "icon": "Image"
            }
        },
        {
            "image/wavespeed": {
                "color": "border-emerald-500",
                "title": "WaveSpeed",
                "description": "Image editing nodes (Nano Banana, GPT Image) using the WaveSpeed AI API",
                "icon": "Image"
            }
        },
        {
            "video/faceprep": {
                "color": "border-amber-500",
                "title": "Face Prep",
                "description": "Head detection, crop, and paste-back nodes bracketing an external face-swap step",
                "icon": "Video"
            }
        },
        {
            "video/composite": {
                "color": "border-cyan-500",
                "title": "Composite",
                "description": "Chroma-key and matte compositing over background stills or videos",
                "icon": "Layers"
            }
        },
        {
            "config/shot": {
                "color": "border-slate-500",
                "title": "Shot",
                "description": "Settings shared by every node in a shot, wired from one place",
                "icon": "Sliders"
            }
        },
        {
            "storage/spaces": {
                "color": "border-blue-500",
                "title": "Spaces",
                "description": "DigitalOcean Spaces storage utilities",
                "icon": "Cloud"
            }
        },
        {
            "video/comfyui": {
                "color": "border-orange-500",
                "title": "ComfyUI",
                "description": "Serverless ComfyUI workflows run via the RunComfy API",
                "icon": "Video"
            }
        }
    ],
    "nodes": [
        {
            "class_name": "HeyGenAvatarVideo",
            "file_path": "heygen/avatar_video.py",
            "metadata": {
                "category": "video/heygen",
                "description": "Generate a lipsync avatar video from an image and an audio file using HeyGen's Avatar IV engine.",
                "display_name": "HeyGen Avatar Video"
            }
        },
        {
            "class_name": "HeyGenVideoTranslate",
            "file_path": "heygen/video_translate.py",
            "metadata": {
                "category": "video/heygen",
                "description": "Translate a video into one or more languages with lip-sync and voice preservation via HeyGen.",
                "display_name": "HeyGen Video Translate"
            }
        },
        {
            "class_name": "TopazVideoUpscale",
            "file_path": "topaz/video_upscale.py",
            "metadata": {
                "category": "video/topaz",
                "description": "Upscale and/or retime a video with Topaz Labs (Proteus, Iris, Artemis, Nyx; Chronos/Apollo frame interpolation).",
                "display_name": "Topaz Video Upscale"
            }
        },
        {
            "class_name": "TopazImageUpscale",
            "file_path": "topaz/image_upscale.py",
            "metadata": {
                "category": "image/topaz",
                "description": "Upscale and restore a still image with Topaz Labs, with face recovery for lipsync-quality head crops.",
                "display_name": "Topaz Image Upscale"
            }
        },
        {
            "class_name": "WaveSpeedImageEdit",
            "file_path": "wavespeed/image_edit.py",
            "metadata": {
                "category": "image/wavespeed",
                "description": "Edit an image from a prompt + reference images (Nano Banana 2/Pro, GPT Image 2) via WaveSpeed.",
                "display_name": "WaveSpeed Image Edit"
            }
        },
        {
            "class_name": "WaveSpeedInfiniteTalk",
            "file_path": "wavespeed/infinitetalk.py",
            "metadata": {
                "category": "video/wavespeed",
                "description": "Generate a talking video from an image and an audio file via WaveSpeed InfiniteTalk.",
                "display_name": "WaveSpeed InfiniteTalk"
            }
        },
        {
            "class_name": "WaveSpeedInfiniteTalkV2V",
            "file_path": "wavespeed/infinitetalk_v2v.py",
            "metadata": {
                "category": "video/wavespeed",
                "description": "Relipsync an existing video to a new audio track via WaveSpeed InfiniteTalk video-to-video.",
                "display_name": "WaveSpeed InfiniteTalk V2V"
            }
        },
        {
            "class_name": "DetectHeadRegion",
            "file_path": "faceprep/detect_head_region.py",
            "metadata": {
                "category": "video/faceprep",
                "description": "Detect the head in a video and emit a square crop region for face-swap prep.",
                "display_name": "Detect Head Region"
            }
        },
        {
            "class_name": "CropToRegion",
            "file_path": "faceprep/crop_to_region.py",
            "metadata": {
                "category": "video/faceprep",
                "description": "Crop the detected head region out of a video as a square clip (swap intermediate).",
                "display_name": "Crop To Region"
            }
        },
        {
            "class_name": "CompositeRegionBack",
            "file_path": "faceprep/composite_region_back.py",
            "metadata": {
                "category": "video/faceprep",
                "description": "Composite the swapped head region back onto the original plate video.",
                "display_name": "Composite Region Back"
            }
        },
        {
            "class_name": "ZoomToHead",
            "file_path": "faceprep/zoom_to_head.py",
            "metadata": {
                "category": "image/faceprep",
                "description": "Crop a head-and-shoulders zoom from a full-body image, for a higher-quality lipsync pass.",
                "display_name": "Zoom To Head"
            }
        },
        {
            "class_name": "OverlayZoomedVideo",
            "file_path": "composite/overlay_zoomed_video.py",
            "metadata": {
                "category": "video/composite",
                "description": "Overlay a zoomed-in lipsync video over the full-body version, auto-aligned by face.",
                "display_name": "Overlay Zoomed Video"
            }
        },
        {
            "class_name": "CompositeOverBackground",
            "file_path": "composite/composite_over_background.py",
            "metadata": {
                "category": "video/composite",
                "description": "Composite a subject video over a background image or video, keying or matting as needed.",
                "display_name": "Composite Over Background"
            }
        },
        {
            "class_name": "ShotSettings",
            "file_path": "config/shot_settings.py",
            "metadata": {
                "category": "config/shot",
                "description": "Shared shot settings (aspect, resolution, expressiveness) wired to every node that must agree on them.",
                "display_name": "Shot Settings"
            }
        },
        {
            "class_name": "UploadToSpaces",
            "file_path": "dospaces/upload_to_spaces.py",
            "metadata": {
                "category": "storage/spaces",
                "description": "Upload a media artifact to a DigitalOcean Spaces bucket and return its public URL.",
                "display_name": "Upload to Spaces"
            }
        },
        {
            "class_name": "RunComfyScailInfinite",
            "file_path": "ComfyUI/scail_infinite.py",
            "metadata": {
                "category": "video/comfyui",
                "description": "Run the SCAIL Infinite ComfyUI workflow on RunComfy: image + prompts + motion video, optional LoRA and size, cancellable polling, returns the output video URL.",
                "display_name": "RunComfy SCAIL Infinite"
            }
        }
    ]
}
